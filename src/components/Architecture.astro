---
---

<section id="architecture" class="container-page py-12 sm:py-20 lg:py-28">
  <div class="mb-6 sm:mb-12 max-w-2xl">
    <h2 class="section-heading">
      架构总览
    </h2>
    <p class="section-sub">
      App 只讲一种<strong class="font-medium text-[var(--color-text)]">归一化协议</strong>,适配器不进入 App —
      各 Agent 的私有协议差异被隔离在适配器或桥接层,协议升级不动 App。
    </p>
  </div>

  <div class="card overflow-hidden p-4 sm:p-6">
    <p class="-mt-1 mb-3 flex items-center gap-1.5 text-[11px] text-[var(--color-text-subtle)] sm:hidden" aria-hidden="true">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6" />
        <polyline points="9 18 3 12 9 6" transform="translate(6,0)" />
      </svg>
      左右滑动查看完整架构图
    </p>
    <div class="-mx-4 overflow-x-auto px-4 sm:mx-0 sm:px-0">
      <div class="min-w-[720px] sm:min-w-0">
        <svg
          viewBox="0 0 920 480"
          class="block w-full h-auto"
          role="img"
          aria-label="Agent Cast 架构图"
          xmlns="http://www.w3.org/2000/svg"
        >
      <defs>
        <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="currentColor" />
        </marker>
        <marker id="arr-ok" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--color-ok)" />
        </marker>
        <marker id="arr-warn" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--color-warn)" />
        </marker>
        <linearGradient id="accent-grad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.18" />
          <stop offset="100%" stop-color="var(--color-accent)" stop-opacity="0.04" />
        </linearGradient>
      </defs>

      <!-- ============ App container (dashed boundary) ============ -->
      <rect x="20" y="20" width="880" height="200" rx="14"
            fill="url(#accent-grad)" stroke="var(--color-accent)" stroke-opacity="0.35"
            stroke-width="1.5" stroke-dasharray="6 4" />
      <text x="40" y="44" fill="var(--color-text-muted)" font-size="12" font-family="var(--font-mono)">
        HarmonyOS App · Agent Cast
      </text>

      <!-- ============ Top row: Page · ViewModel · Domain · ConnectionManager ============ -->
      <!-- Page layer -->
      <rect x="40" y="60" width="200" height="140" rx="8" fill="var(--color-bg-elevated)" stroke="var(--color-border)" />
      <text x="140" y="86" fill="var(--color-text)" font-size="13" text-anchor="middle" font-weight="600">页面层</text>
      <text x="140" y="106" fill="var(--color-text-muted)" font-size="11" text-anchor="middle" font-family="var(--font-mono)">ArkUI</text>
      <text x="140" y="134" fill="var(--color-text-muted)" font-size="10" text-anchor="middle">Chat · Sessions</text>
      <text x="140" y="150" fill="var(--color-text-muted)" font-size="10" text-anchor="middle">Agents · Settings</text>
      <text x="140" y="180" fill="var(--color-text-subtle)" font-size="9" text-anchor="middle" font-family="var(--font-mono)">@ComponentV2</text>

      <!-- ViewModel layer -->
      <rect x="260" y="60" width="200" height="140" rx="8" fill="var(--color-bg-elevated)" stroke="var(--color-border)" />
      <text x="360" y="86" fill="var(--color-text)" font-size="13" text-anchor="middle" font-weight="600">视图模型</text>
      <text x="360" y="106" fill="var(--color-text-muted)" font-size="11" text-anchor="middle" font-family="var(--font-mono)">@ObservedV2 · @Trace</text>
      <text x="360" y="134" fill="var(--color-text-muted)" font-size="10" text-anchor="middle">ChatViewModel</text>
      <text x="360" y="150" fill="var(--color-text-muted)" font-size="10" text-anchor="middle">FilesViewModel</text>

      <!-- Domain model -->
      <rect x="480" y="60" width="200" height="140" rx="8" fill="var(--color-bg-elevated)" stroke="var(--color-border)" />
      <text x="580" y="86" fill="var(--color-text)" font-size="13" text-anchor="middle" font-weight="600">归一化事件</text>
      <text x="580" y="106" fill="var(--color-text-muted)" font-size="11" text-anchor="middle" font-family="var(--font-mono)">StreamEvent</text>
      <text x="580" y="134" fill="var(--color-text-muted)" font-size="10" text-anchor="middle">Session · Message</text>
      <text x="580" y="150" fill="var(--color-text-muted)" font-size="10" text-anchor="middle">ToolCall · Approval</text>

      <!-- ConnectionManager (emphasized) -->
      <rect x="700" y="60" width="200" height="140" rx="8" fill="var(--color-bg-card)"
            stroke="var(--color-accent)" stroke-opacity="0.5" />
      <text x="800" y="86" fill="var(--color-accent)" font-size="13" text-anchor="middle" font-weight="600">ConnectionManager</text>
      <text x="800" y="106" fill="var(--color-text-muted)" font-size="11" text-anchor="middle">Profile 路由 · 重连</text>
      <text x="800" y="134" fill="var(--color-text-muted)" font-size="10" text-anchor="middle" font-family="var(--font-mono)">kind → adapter 注册表</text>
      <text x="800" y="150" fill="var(--color-text-muted)" font-size="10" text-anchor="middle">指数退避 · HUKS Token</text>

      <!-- arrows between top-row layers -->
      <line x1="240" y1="130" x2="260" y2="130" stroke="currentColor" stroke-width="1.2" marker-end="url(#arr)" />
      <line x1="460" y1="130" x2="480" y2="130" stroke="currentColor" stroke-width="1.2" marker-end="url(#arr)" />
      <line x1="680" y1="130" x2="700" y2="130" stroke="currentColor" stroke-width="1.2" marker-end="url(#arr)" />

      <!-- ============ Middle row: Transports · Adapters · Persistence ============ -->
      <!-- Transports -->
      <rect x="40" y="220" width="300" height="60" rx="8" fill="var(--color-bg-elevated)" stroke="var(--color-border)" />
      <text x="60" y="244" fill="var(--color-text)" font-size="12" font-weight="600">传输层</text>
      <text x="60" y="266" fill="var(--color-text-muted)" font-size="11" font-family="var(--font-mono)">SSE · WebSocket · HTTP</text>

      <!-- Adapters -->
      <rect x="360" y="220" width="280" height="60" rx="8" fill="var(--color-bg-elevated)" stroke="var(--color-border)" />
      <text x="500" y="244" fill="var(--color-text)" font-size="12" text-anchor="middle" font-weight="600">适配器</text>
      <text x="500" y="266" fill="var(--color-text-muted)" font-size="11" text-anchor="middle" font-family="var(--font-mono)">Hermes · OpenCode · OpenClaw</text>

      <!-- Persistence -->
      <rect x="660" y="220" width="240" height="60" rx="8" fill="var(--color-bg-elevated)" stroke="var(--color-border)" />
      <text x="780" y="244" fill="var(--color-text)" font-size="12" text-anchor="middle" font-weight="600">持久化</text>
      <text x="780" y="266" fill="var(--color-text-muted)" font-size="11" text-anchor="middle" font-family="var(--font-mono)">RelationalStore · HUKS</text>

      <!-- CM → middle row (3 arrows from CM bottom-center) -->
      <line x1="800" y1="200" x2="190" y2="216" stroke="currentColor" stroke-width="1.1"
            stroke-dasharray="3 3" marker-end="url(#arr)" opacity="0.7" />
      <line x1="800" y1="200" x2="500" y2="216" stroke="currentColor" stroke-width="1.1"
            stroke-dasharray="3 3" marker-end="url(#arr)" opacity="0.7" />
      <line x1="800" y1="200" x2="780" y2="216" stroke="currentColor" stroke-width="1.1"
            stroke-dasharray="3 3" marker-end="url(#arr)" opacity="0.7" />

      <!-- ============ External endpoints ============ -->
      <text x="40" y="320" fill="var(--color-text-muted)" font-size="12" font-family="var(--font-mono)">
        桌面 / 服务器 · 自部署 Agent
      </text>

      <!-- Hermes -->
      <rect x="40" y="340" width="200" height="80" rx="10" fill="var(--color-bg-card)" stroke="var(--color-border-strong)" />
      <text x="140" y="366" fill="var(--color-text)" font-size="13" text-anchor="middle" font-weight="600">Hermes</text>
      <text x="140" y="386" fill="var(--color-text-muted)" font-size="10" text-anchor="middle">API Server · OpenAI 兼容</text>
      <text x="140" y="404" fill="var(--color-text-muted)" font-size="10" text-anchor="middle" font-family="var(--font-mono)">/v1 + SSE</text>

      <!-- OpenCode -->
      <rect x="260" y="340" width="200" height="80" rx="10" fill="var(--color-bg-card)" stroke="var(--color-border-strong)" />
      <text x="360" y="366" fill="var(--color-text)" font-size="13" text-anchor="middle" font-weight="600">OpenCode</text>
      <text x="360" y="386" fill="var(--color-text-muted)" font-size="10" text-anchor="middle">opencode serve</text>
      <text x="360" y="404" fill="var(--color-text-muted)" font-size="10" text-anchor="middle" font-family="var(--font-mono)">/global/event SSE</text>

      <!-- Bridge container (dashed) -->
      <rect x="480" y="340" width="200" height="80" rx="10" fill="var(--color-bg-card)"
            stroke="var(--color-warn)" stroke-opacity="0.55" stroke-dasharray="5 4" />
      <text x="580" y="366" fill="var(--color-text)" font-size="13" text-anchor="middle" font-weight="600">桥接容器</text>
      <text x="580" y="386" fill="var(--color-text-muted)" font-size="10" text-anchor="middle">bridge · Docker</text>
      <text x="580" y="404" fill="var(--color-text-muted)" font-size="10" text-anchor="middle" font-family="var(--font-mono)">Gateway WS ↔ 归一化</text>

      <!-- A2A (lighter / muted) -->
      <rect x="700" y="340" width="200" height="80" rx="10" fill="var(--color-bg-card)"
            stroke="var(--color-border-strong)" stroke-opacity="0.6" />
      <text x="800" y="366" fill="var(--color-text-muted)" font-size="13" text-anchor="middle" font-weight="600">A2A</text>
      <text x="800" y="386" fill="var(--color-text-subtle)" font-size="10" text-anchor="middle">HTTP binding</text>
      <text x="800" y="404" fill="var(--color-text-subtle)" font-size="10" text-anchor="middle">远期 · 鸿蒙小艺</text>

      <!-- middle row → external endpoints -->
      <line x1="190" y1="280" x2="140" y2="340" stroke="var(--color-ok)" stroke-width="1.4"
            marker-end="url(#arr-ok)" />
      <line x1="500" y1="280" x2="360" y2="340" stroke="var(--color-ok)" stroke-width="1.4"
            marker-end="url(#arr-ok)" />
      <line x1="500" y1="280" x2="580" y2="340" stroke="var(--color-warn)" stroke-width="1.4"
            marker-end="url(#arr-warn)" stroke-dasharray="4 3" />
      <line x1="780" y1="280" x2="800" y2="340" stroke="var(--color-border-strong)" stroke-width="1.2"
            stroke-dasharray="2 3" marker-end="url(#arr)" />

      <!-- OpenClaw Gateway -->
      <rect x="480" y="450" width="200" height="22" rx="6" fill="var(--color-bg-elevated)"
            stroke="var(--color-border)" />
      <text x="580" y="466" fill="var(--color-text-muted)" font-size="11" text-anchor="middle" font-family="var(--font-mono)">
        OpenClaw Gateway :18789
      </text>
      <!-- bridge → gateway (dashed) -->
      <line x1="580" y1="420" x2="580" y2="450" stroke="currentColor" stroke-width="1.2"
            stroke-dasharray="3 3" marker-end="url(#arr)" />
        </svg>
      </div>
    </div>
  </div>

  <div class="mt-5 sm:mt-6 flex flex-wrap gap-x-5 gap-y-2 text-xs sm:text-sm text-[var(--color-text-muted)]">
    <div class="flex items-center gap-2">
      <span class="inline-block h-2 w-2 rounded-full bg-[var(--color-ok)]"></span>
      已实装的传输链路
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-block h-2 w-2 rounded-full bg-[var(--color-warn)]"></span>
      桥接中(协议版本漂移隔离层)
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-block h-2 w-2 rounded-full bg-[var(--color-border-strong)]"></span>
      远期 / 占位
    </div>
  </div>
</section>