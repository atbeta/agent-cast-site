---
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  pathname === href || pathname.startsWith(href + "/");

const links = [
  { href: "/guide", label: "使用指南", shortLabel: "指南", short: true },
  { href: "/privacy", label: "隐私政策" },
];
const externalLinks = [
  {
    href: "https://github.com/atbeta/agent-cast",
    label: "GitHub 仓库",
    icon: "github",
  },
  {
    href: "https://github.com/atbeta/agent-cast/issues",
    label: "反馈问题",
    icon: "issue",
  },
];
---

<nav class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[color-mix(in_oklab,var(--color-bg)_85%,transparent)] backdrop-blur-xl">
  <div class="container-page flex h-14 items-center justify-between gap-2">
    <a href="/" class="flex items-center gap-2 font-semibold min-w-0">
      <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-[var(--color-accent)] text-white">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 8.82a15 15 0 0 1 20 0" />
          <path d="M5 12.86a10 10 0 0 1 14 0" />
          <path d="M8.5 16.43a5 5 0 0 1 7 0" />
          <circle cx="12" cy="20" r="1.5" fill="currentColor" stroke="none" />
        </svg>
      </span>
      <span class="truncate">Agent Cast</span>
      <span class="badge ml-1 hidden sm:inline-flex">v1.0.0</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden items-center gap-1 text-sm sm:flex">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={["btn-ghost", isActive(l.href) && "text-[var(--color-text)]"]}
        >
          {l.label}
        </a>
      ))}
      <a
        href={externalLinks[0].href}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost gap-1.5"
        aria-label={externalLinks[0].label}
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.4 3-.405 1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </svg>
        <span class="hidden md:inline">GitHub</span>
      </a>
      <a href="/guide#download" class="btn-primary ml-1">
        下载
      </a>
    </div>

    <!-- Mobile: download pill + hamburger -->
    <div class="flex items-center gap-2 sm:hidden">
      <a href="/guide#download" class="btn-primary py-2 px-3 text-xs">
        下载
      </a>
      <button
        type="button"
        id="nav-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-[var(--color-border)] bg-[var(--color-bg-elevated)] text-[var(--color-text-muted)] active:scale-95"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="nav-drawer"
      >
        <svg id="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7" class="nav-line nav-line-1" />
          <line x1="4" y1="12" x2="20" y2="12" class="nav-line nav-line-2" />
          <line x1="4" y1="17" x2="20" y2="17" class="nav-line nav-line-3" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div
    id="nav-drawer"
    class="hidden border-t border-[var(--color-border)] bg-[color-mix(in_oklab,var(--color-bg)_92%,transparent)] backdrop-blur-xl sm:hidden"
  >
    <div class="container-page flex flex-col py-2">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            "flex items-center justify-between rounded-md px-3 py-3 text-sm font-medium",
            isActive(l.href)
              ? "bg-[var(--color-bg-elevated)] text-[var(--color-text)]"
              : "text-[var(--color-text-muted)] hover:bg-[var(--color-bg-elevated)] hover:text-[var(--color-text)]",
          ]}
        >
          {l.label}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="opacity-50">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </a>
      ))}
      <div class="my-2 border-t border-[var(--color-border)]"></div>
      {externalLinks.map((l) => (
        <a
          href={l.href}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 rounded-md px-3 py-3 text-sm font-medium text-[var(--color-text-muted)] hover:bg-[var(--color-bg-elevated)] hover:text-[var(--color-text)]"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.4 3-.405 1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
          </svg>
          {l.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById("nav-toggle");
  const drawer = document.getElementById("nav-drawer");
  const icon = document.getElementById("nav-icon");
  if (toggle && drawer && icon) {
    const setOpen = (open: boolean) => {
      drawer.classList.toggle("hidden", !open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "关闭菜单" : "打开菜单");
      icon.classList.toggle("nav-open", open);
    };
    toggle.addEventListener("click", () => {
      setOpen(drawer.classList.contains("hidden"));
    });
    drawer.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => setOpen(false));
    });
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 640) setOpen(false);
    });
  }
</script>

<style>
  .nav-line {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 200ms ease, opacity 200ms ease;
  }
  .nav-open .nav-line-1 {
    transform: translateY(5px) rotate(45deg);
  }
  .nav-open .nav-line-2 {
    opacity: 0;
  }
  .nav-open .nav-line-3 {
    transform: translateY(-5px) rotate(-45deg);
  }
</style>
