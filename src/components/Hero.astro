---
import PhoneFrame from "./PhoneFrame.astro";
import ConsoleScreen from "./mocks/ConsoleScreen.astro";
---

<section class="relative overflow-hidden">
  <div class="absolute inset-0 grid-pattern opacity-60" aria-hidden="true"></div>
  <div
    class="absolute inset-x-0 top-0 -z-10 h-[320px] sm:h-[480px] bg-gradient-to-b from-[color-mix(in_oklab,var(--color-accent)_18%,transparent)] to-transparent"
    aria-hidden="true"
  ></div>

  <div class="container-page relative pt-12 pb-10 sm:pt-24 sm:pb-20 lg:pt-28 lg:pb-24">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-14">
      <div class="flex flex-col items-start gap-5 sm:gap-6 max-w-3xl">
        <span class="badge badge-accent text-[11px] sm:text-xs">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] animate-pulse"></span>
          v1.0.0 已发布 · HarmonyOS 5.0+
        </span>

        <h1 class="text-balance text-[2rem] font-semibold leading-[1.15] tracking-tight sm:text-5xl sm:leading-[1.05] md:text-6xl lg:text-7xl">
          一声令下,
          <span class="gradient-text">投送给你的 Agent</span>
        </h1>

        <p class="text-balance text-[0.95rem] leading-relaxed text-[var(--color-text-muted)] sm:text-lg lg:text-xl max-w-2xl">
          Agent Cast 是一款 HarmonyOS 原生、轻量、多 Agent 通用的「桌面 Agent 遥控器」。
          手机即遥控器——<strong class="font-medium text-[var(--color-text)]">聊天、看工具执行、审批 Agent 的动作</strong>,
          不做 IM。
        </p>

        <div class="mt-3 sm:mt-4 flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-2.5 sm:gap-3 w-full sm:w-auto">
          <a href="/guide#download" class="btn-primary justify-center sm:justify-start">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" y1="15" x2="12" y2="3" />
            </svg>
            下载 Agent Cast
          </a>
          <a href="/guide" class="btn-secondary justify-center sm:justify-start">查看使用指南</a>
          <a
            href="https://github.com/atbeta/agent-cast"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost justify-center sm:justify-start gap-1.5"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.4 3-.405 1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
            </svg>
            GitHub
          </a>
        </div>

        <div class="mt-6 sm:mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs sm:text-sm text-[var(--color-text-muted)]">
          <span class="inline-flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-ok)]" aria-hidden="true">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            永久免费
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-ok)]" aria-hidden="true">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            数据全本地
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-ok)]" aria-hidden="true">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            鸿蒙原生
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-ok)]" aria-hidden="true">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            Token HUKS 加密
          </span>
        </div>
      </div>

      <!-- 手机实机 mockup：控制台 -->
      <div class="flex justify-center lg:justify-end">
        <div class="w-[210px] max-w-full sm:w-[280px] lg:w-[320px]">
          <PhoneFrame variant="light">
            <ConsoleScreen />
          </PhoneFrame>
        </div>
      </div>
    </div>
  </div>
</section>
