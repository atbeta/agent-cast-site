---
import PhoneFrame from "./PhoneFrame.astro";
import ConsoleScreen from "./mocks/ConsoleScreen.astro";
import SessionsScreen from "./mocks/SessionsScreen.astro";
import ChatScreen from "./mocks/ChatScreen.astro";
import ApprovalScreen from "./mocks/ApprovalScreen.astro";
import QuestionScreen from "./mocks/QuestionScreen.astro";
import DarkChatScreen from "./mocks/DarkChatScreen.astro";

/**
 * 6 屏忠实还原（对应 AppGallery 上架截图清单 docs/store/listing.md）。
 * 拿到真截图后：把文件放 public/screens/，填 img 字段即替换 mockup。
 */
const screens = [
  {
    title: "控制台",
    subtitle: "概览卡 · 最近实例 · 进行中任务",
    Mock: ConsoleScreen,
    variant: "light",
    img: "",
  },
  {
    title: "会话列表",
    subtitle: "搜索筛选 · 状态徽标分组",
    Mock: SessionsScreen,
    variant: "light",
    img: "",
  },
  {
    title: "聊天页",
    subtitle: "流式回复 · 思考过程 · 工具调用",
    Mock: ChatScreen,
    variant: "light",
    img: "",
  },
  {
    title: "审批中心",
    subtitle: "高危操作等你拍板 · 差异化核心",
    Mock: ApprovalScreen,
    variant: "light",
    img: "",
  },
  {
    title: "Agent 提问",
    subtitle: "选项一点即答",
    Mock: QuestionScreen,
    variant: "light",
    img: "",
  },
  {
    title: "深色模式聊天",
    subtitle: "全套暗色 · Diff 文件级查看",
    Mock: DarkChatScreen,
    variant: "dark",
    img: "",
  },
];
---

<section id="screenshots" class="container-page py-12 sm:py-20 lg:py-28">
  <div class="mb-6 sm:mb-12 max-w-2xl">
    <h2 class="section-heading">
      看得见的 Agent 操作
    </h2>
    <p class="section-sub">
      不是 IM,是真正的 Agent 遥控器 — 看它在想什么、看它在做什么、看它改了什么。
      六屏还原 App 真实界面,可直接作为华为应用市场截图素材。
    </p>
  </div>

  <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3">
    {screens.map((s) => (
      <figure class="card card-hover group overflow-hidden p-0">
        <div class="relative flex items-center justify-center bg-[var(--color-bg-elevated)] px-3 py-5 sm:px-4 sm:py-6">
          <div class="w-[150px] sm:w-[170px] lg:w-[200px]">
            <PhoneFrame variant={s.variant}>
              <s.Mock />
            </PhoneFrame>
          </div>
          {s.img && (
            <img
              src={s.img}
              alt={`${s.title} 截图`}
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
            />
          )}
        </div>
        <figcaption class="border-t border-[var(--color-border)] p-3 sm:p-4">
          <p class="text-sm font-medium sm:text-base">{s.title}</p>
          <p class="mt-0.5 text-xs text-[var(--color-text-muted)] sm:text-sm sm:mt-1">{s.subtitle}</p>
        </figcaption>
      </figure>
    ))}
  </div>

  <p class="mt-6 sm:mt-8 text-center text-xs sm:text-sm text-[var(--color-text-subtle)]">
    当前为 HTML mockup(忠实还原 App UI)· 正式截图替换时把文件放
    <code class="font-mono">public/screens/</code> 并填入 <code class="font-mono">img</code> 字段
  </p>
</section>
