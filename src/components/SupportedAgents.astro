---
const agents = [
  {
    name: "Hermes",
    protocol: "Hermes API + SSE",
    status: "stable",
    note: "会话链路主路径 — 思考过程 + 审批按钮 + 服务端中断",
    href: "/guide#hermes",
  },
  {
    name: "OpenCode",
    protocol: "OpenCode HTTP + SSE",
    status: "stable",
    note: "真流式主路径 — 断线回退轮询,Diff 文件级查看",
    href: "/guide#opencode",
  },
  {
    name: "OpenAI 兼容",
    protocol: "OpenAI 兼容 SSE",
    status: "stable",
    note: "通用 chat/completions — vLLM / llama.cpp 等",
    href: null,
  },
  {
    name: "OpenClaw",
    protocol: "WebSocket + JSON-RPC",
    status: "wip",
    note: "Gateway WS 客户端已实装 — 审批/桥接完善中 (M2)",
    href: "/guide#openclaw",
  },
  {
    name: "A2A",
    protocol: "A2A HTTP",
    status: "planned",
    note: "预留 — 借鸿蒙小艺开放平台接入",
    href: null,
  },
];

const statusLabel: Record<string, { text: string; cls: string }> = {
  stable: { text: "已实装", cls: "badge-ok" },
  wip: { text: "开发中", cls: "badge-warn" },
  planned: { text: "远期", cls: "badge" },
};
---

<section id="agents" class="container-page py-12 sm:py-20 lg:py-28">
  <div class="mb-6 sm:mb-12 max-w-2xl">
    <h2 class="section-heading">
      支持的 Agent
    </h2>
    <p class="section-sub">
      通过<strong class="font-medium text-[var(--color-text)]">归一化事件模型 + 适配器</strong>接入,后续扩展新 Agent 只需新增一个适配器。
    </p>
  </div>

  <!-- Mobile: card list -->
  <div class="grid gap-3 sm:hidden">
    {agents.map((a) => {
      const s = statusLabel[a.status];
      return (
        <article class="card p-4">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              {a.href ? (
                <a href={a.href} class="text-base font-semibold hover:text-[var(--color-accent)]">
                  {a.name}
                </a>
              ) : (
                <p class="text-base font-semibold">{a.name}</p>
              )}
              <p class="mt-1 break-all font-mono text-[11px] text-[var(--color-text-muted)]">
                {a.protocol}
              </p>
            </div>
            <span class:list={["badge shrink-0", s.cls]}>{s.text}</span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-[var(--color-text-muted)]">
            {a.note}
          </p>
        </article>
      );
    })}
  </div>

  <!-- sm+: table -->
  <div class="hidden overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] sm:block">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-[var(--color-border)] bg-[var(--color-bg-elevated)]">
            <th class="px-4 py-2.5 sm:px-5 sm:py-3 text-left font-medium text-[var(--color-text-muted)] whitespace-nowrap">Agent</th>
            <th class="px-4 py-2.5 sm:px-5 sm:py-3 text-left font-medium text-[var(--color-text-muted)] whitespace-nowrap">传输协议</th>
            <th class="px-4 py-2.5 sm:px-5 sm:py-3 text-left font-medium text-[var(--color-text-muted)] whitespace-nowrap">状态</th>
            <th class="px-4 py-2.5 sm:px-5 sm:py-3 text-left font-medium text-[var(--color-text-muted)]">备注</th>
          </tr>
        </thead>
        <tbody>
          {agents.map((a) => {
            const s = statusLabel[a.status];
            return (
              <tr class="border-b border-[var(--color-border)] last:border-0 transition-colors hover:bg-[var(--color-bg-elevated)]">
                <td class="px-4 py-3 sm:px-5 sm:py-4 whitespace-nowrap">
                  {a.href ? (
                    <a href={a.href} class="font-medium hover:text-[var(--color-accent)]">{a.name}</a>
                  ) : (
                    <span class="font-medium">{a.name}</span>
                  )}
                </td>
                <td class="px-4 py-3 sm:px-5 sm:py-4 font-mono text-xs text-[var(--color-text-muted)] whitespace-nowrap">{a.protocol}</td>
                <td class="px-4 py-3 sm:px-5 sm:py-4">
                  <span class:list={["badge", s.cls]}>{s.text}</span>
                </td>
                <td class="px-4 py-3 sm:px-5 sm:py-4 text-[var(--color-text-muted)] text-xs sm:text-sm">{a.note}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>
</section>
