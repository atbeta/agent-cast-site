---
const features = [
  {
    icon: "phone",
    title: "HarmonyOS 原生",
    desc: "ArkTS / ArkUI / Stage 模型,HarmonyOS 5.0+ (API 12+) 原生运行。该生态目前无任何 Agent 遥控客户端。",
  },
  {
    icon: "plug",
    title: "归一化多 Agent",
    desc: "一个 App 通吃 Hermes / OpenCode / OpenClaw / OpenAI 兼容。按 AgentKind 路由适配器,协议漂移被隔离在桥接层,App 永不因升级失效。",
  },
  {
    icon: "shield-check",
    title: "人在环路,安全可控",
    desc: "Agent 要执行高危操作时审批卡实时推到你手上:允许一次、会话内免问、始终信任,或带原因拒绝让它纠正重来。",
  },
  {
    icon: "activity",
    title: "完整回合体验",
    desc: "流式正文、思考过程、工具调用卡片、Token 与耗时统计——桌面端发生什么,手机端看到什么。",
  },
  {
    icon: "bell",
    title: "离开也放心",
    desc: "后台长时任务保持连接,回合完成、审批到达均有系统通知与触感反馈。人离开电脑,事不停。",
  },
  {
    icon: "grid",
    title: "桌面服务卡片",
    desc: "进行中的任务直接放上手机桌面,一点直达会话,不用打开 App 就能看到进度。",
  },
  {
    icon: "layers",
    title: "多实例,一处掌控",
    desc: "同时接入多个 Agent 服务,概览卡一览在线状态、时延与进行中任务,按实例筛选会话。",
  },
  {
    icon: "sliders",
    title: "上下文与导出",
    desc: "上下文窗口用量可视化、超限预警,会话一键导出 Markdown,聊天记录随时带走。",
  },
];
---

<section id="features" class="container-page py-12 sm:py-20 lg:py-28">
  <div class="mb-6 sm:mb-12 max-w-2xl">
    <h2 class="section-heading">
      为自部署 Agent 的开发者设计
    </h2>
    <p class="section-sub">
      你的 Agent 跑在 NAS / 服务器 / 桌面 Docker 上,手机就是最方便的遥控器。
    </p>
  </div>

  <div class="grid gap-3 sm:gap-4 sm:grid-cols-2">
    {features.map((f) => (
      <article class="card card-hover group">
        <div class="flex items-start gap-3 sm:gap-4">
          <span class="inline-flex h-9 w-9 sm:h-10 sm:w-10 shrink-0 items-center justify-center rounded-md bg-[color-mix(in_oklab,var(--color-accent)_15%,transparent)] text-[var(--color-accent)] ring-1 ring-[color-mix(in_oklab,var(--color-accent)_25%,transparent)]">
            {f.icon === "phone" && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sm:h-5 sm:w-5"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
            )}
            {f.icon === "plug" && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sm:h-5 sm:w-5"><path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v4a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8z"/></svg>
            )}
            {f.icon === "shield-check" && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sm:h-5 sm:w-5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
            )}
            {f.icon === "activity" && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sm:h-5 sm:w-5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            )}
            {f.icon === "bell" && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sm:h-5 sm:w-5"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
            )}
            {f.icon === "grid" && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sm:h-5 sm:w-5"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            )}
            {f.icon === "layers" && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sm:h-5 sm:w-5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
            )}
            {f.icon === "sliders" && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sm:h-5 sm:w-5"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
            )}
          </span>
          <div class="min-w-0">
            <h3 class="text-base font-semibold sm:text-lg">{f.title}</h3>
            <p class="mt-1 sm:mt-1.5 text-sm leading-relaxed text-[var(--color-text-muted)]">
              {f.desc}
            </p>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
