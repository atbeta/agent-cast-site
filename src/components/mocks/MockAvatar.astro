---
/** Agent 头像占位：按 kind 配色 + 内部 SVG glyph。size 为 cqw 值对应的字号容器。 */
interface Props {
  kind?: string;
  label?: string;
  size?: string;
  rounded?: string;
}

const {
  kind = "generic",
  label = "A",
  size = "10cqw",
} = Astro.props;
---

<span
  class:list={["mock-avatar", `mock-avatar-${kind}`]}
  style={`width:${size};height:${size};`}
  aria-hidden="true"
>
  {kind === "opencode" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:48%;height:48%;">
      <rect x="6" y="2.5" width="12" height="19" rx="2.5" />
      <line x1="9.5" y1="5.5" x2="14.5" y2="5.5" />
      <circle cx="12" cy="18.5" r="0.7" fill="currentColor" stroke="none" />
    </svg>
  )}
  {kind === "openclaw" && (
    <svg viewBox="0 0 32 32" fill="currentColor" style="width:78%;height:78%;">
      <!-- body -->
      <ellipse cx="16" cy="19" rx="9" ry="8.5" />
      <!-- ears -->
      <path d="M9 7.5l1.6 5.5L13.5 11z" />
      <path d="M23 7.5l-1.6 5.5L18.5 11z" />
      <!-- eyes -->
      <circle cx="12.5" cy="17" r="2.2" fill="#fff" />
      <circle cx="19.5" cy="17" r="2.2" fill="#fff" />
      <circle cx="13" cy="17.5" r="1.1" fill="#0d1117" />
      <circle cx="20" cy="17.5" r="1.1" fill="#0d1117" />
      <!-- smile -->
      <path d="M13.5 22.5 Q16 24.5 18.5 22.5" stroke="#fff" stroke-width="1.4" stroke-linecap="round" fill="none" />
      <!-- cheeks -->
      <circle cx="10" cy="21" r="1.2" fill="#fca5a5" opacity="0.7" />
      <circle cx="22" cy="21" r="1.2" fill="#fca5a5" opacity="0.7" />
    </svg>
  )}
  {kind === "hermes" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:60%;height:60%;">
      <path d="M13 2 4 14h7l-1 8 9-12h-7z" />
    </svg>
  )}
  {!["opencode", "openclaw", "hermes"].includes(kind) && (
    <span style={`font-size:calc(${size} * 0.42)`}>{label}</span>
  )}
</span>