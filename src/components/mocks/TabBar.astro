---
interface Props {
  active: "console" | "instances" | "sessions" | "settings";
}

const { active } = Astro.props;

const tabs = [
  { key: "console", label: "控制台", icon: "home" },
  { key: "instances", label: "实例", icon: "grid" },
  { key: "sessions", label: "会话", icon: "chat" },
  { key: "settings", label: "设置", icon: "gear" },
] as const;
---

<div class="mock-tabbar">
  {tabs.map((t) => (
    <div class:list={["mock-tab", active === t.key && "mock-tab-active"]}>
      {t.icon === "home" && (
        <svg viewBox="0 0 24 24" class="h-[3.8cqw] w-[3.8cqw]" aria-hidden="true">
          <path d="M3 11.5 12 4l9 7.5V20a1 1 0 0 1-1 1h-4v-6h-4v6H4a1 1 0 0 1-1-1z" fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
        </svg>
      )}
      {t.icon === "grid" && (
        <svg viewBox="0 0 24 24" class="h-[3.8cqw] w-[3.8cqw]" aria-hidden="true">
          <g fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7" rx="1.6" />
            <rect x="14" y="3" width="7" height="7" rx="1.6" />
            <rect x="3" y="14" width="7" height="7" rx="1.6" />
            <rect x="14" y="14" width="7" height="7" rx="1.6" />
          </g>
        </svg>
      )}
      {t.icon === "chat" && (
        <svg viewBox="0 0 24 24" class="h-[3.8cqw] w-[3.8cqw]" aria-hidden="true">
          <path d="M5 4h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H10l-4.5 4v-4H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
        </svg>
      )}
      {t.icon === "gear" && (
        <svg viewBox="0 0 24 24" class="h-[3.8cqw] w-[3.8cqw]" aria-hidden="true">
          <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
          <circle cx="12" cy="12" r="3" fill="currentColor" />
        </svg>
      )}
      <span>{t.label}</span>
    </div>
  ))}
</div>