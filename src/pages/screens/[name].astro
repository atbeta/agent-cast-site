---
import "../../styles/global.css";
import ConsoleScreen from "../../components/mocks/ConsoleScreen.astro";
import SessionsScreen from "../../components/mocks/SessionsScreen.astro";
import ChatScreen from "../../components/mocks/ChatScreen.astro";
import ApprovalScreen from "../../components/mocks/ApprovalScreen.astro";
import QuestionScreen from "../../components/mocks/QuestionScreen.astro";
import DarkChatScreen from "../../components/mocks/DarkChatScreen.astro";

export const prerender = true;

export function getStaticPaths() {
  return [
    { params: { name: "console" } },
    { params: { name: "sessions" } },
    { params: { name: "chat" } },
    { params: { name: "approval" } },
    { params: { name: "question" } },
    { params: { name: "dark-chat" } },
  ];
}

const { name } = Astro.params as { name: string };

const entry = {
  console: { Comp: ConsoleScreen, variant: "light" as const },
  sessions: { Comp: SessionsScreen, variant: "light" as const },
  chat: { Comp: ChatScreen, variant: "light" as const },
  approval: { Comp: ApprovalScreen, variant: "light" as const },
  question: { Comp: QuestionScreen, variant: "light" as const },
  "dark-chat": { Comp: DarkChatScreen, variant: "dark" as const },
}[name];

if (!entry) {
  return Astro.redirect("/404");
}

const { Comp, variant } = entry;
const onDark = variant === "dark";
const chrome = onDark ? "#e6ebf2" : "#0f141c";
---

<!doctype html>
<html lang="zh-CN" style="background:#000;height:100%;margin:0;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content={onDark ? "#0e1014" : "#eef1f5"} />
    <title>screen · {name}</title>
  </head>
  <body style={`background:${onDark ? "#0e1014" : "#eef1f5"};color:${chrome};margin:0;height:100vh;overflow:hidden;`}>
    <div class="phone-render">
      <div class="status-bar">
        <div class="status-left">
          <span class="status-time">9:41</span>
          <span class="status-pill" aria-hidden="true">
            <svg viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 1 1 4l4 3" />
              <path d="M11 7V1" />
            </svg>
          </span>
        </div>
        <div class="status-hole" aria-hidden="true"></div>
        <div class="status-icons">
          <svg viewBox="0 0 16 12" fill="currentColor" class="status-ico" aria-hidden="true">
            <rect x="0" y="7" width="3" height="5" rx="0.6" />
            <rect x="4.5" y="4.5" width="3" height="7.5" rx="0.6" />
            <rect x="9" y="2" width="3" height="10" rx="0.6" />
            <rect x="13.5" y="0" width="3" height="12" rx="0.6" opacity="0.35" />
          </svg>
          <svg viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class="status-ico" aria-hidden="true">
            <path d="M1 4a11 11 0 0 1 14 0" />
            <path d="M3.5 6.5a7.5 7.5 0 0 1 9 0" />
            <path d="M6 9a4 4 0 0 1 4 0" />
            <circle cx="8" cy="10.8" r="0.7" fill="currentColor" stroke="none" />
          </svg>
          <span class="status-batt-wrap">
            <svg viewBox="0 0 30 14" class="status-batt" aria-hidden="true">
              <rect x="0.6" y="0.6" width="26" height="12.8" rx="3" fill="none" stroke="currentColor" stroke-width="1.2" />
              <rect x="2.4" y="2.4" width="22.4" height="9.2" rx="1.6" fill="currentColor" />
              <rect x="27.6" y="5" width="2" height="4" rx="0.7" fill="currentColor" />
            </svg>
            <span class="status-batt-pct">100</span>
            <svg viewBox="0 0 14 14" fill="currentColor" class="status-bolt" aria-hidden="true">
              <path d="M8.5 1 3 8h4l-1.5 5L11 6H7z" />
            </svg>
          </span>
        </div>
      </div>
      <div class="screen-content">
        <Comp />
      </div>
      <!-- home indicator -->
      <div class="home-indicator" aria-hidden="true"></div>
    </div>
  </body>
</html>

<style>
  @reference "../../styles/global.css";

  .phone-render {
    display: flex;
    flex-direction: column;
    width: 100vw;
    height: 100vh;
    container-type: inline-size;
  }

  .status-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 4%;
    padding-top: 4%;
    flex-shrink: 0;
  }

  .status-left {
    display: flex;
    align-items: center;
    gap: 6%;
  }

  .status-time {
    font-size: 3.4cqw;
    font-weight: 700;
    letter-spacing: -0.01em;
    font-family: var(--font-sans);
    color: inherit;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.8cqw;
    height: 2.8cqw;
    background: #1a73e8;
    border-radius: 0.8cqw;
    color: #fff;
  }
  .status-pill svg {
    width: 75%;
    height: 75%;
  }

  .status-hole {
    position: absolute;
    left: 50%;
    top: 32%;
    width: 22%;
    height: 5%;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #000;
  }

  .status-icons {
    display: flex;
    align-items: center;
    gap: 2.8%;
  }

  .status-ico {
    height: 1.15em;
    width: auto;
  }

  .status-batt-wrap {
    display: inline-flex;
    align-items: center;
    gap: 1cqw;
    margin-left: 1cqw;
  }

  .status-batt {
    width: 2.1em;
  }

  .status-batt-pct {
    font-size: 2.6cqw;
    font-weight: 700;
    font-feature-settings: "tnum";
    letter-spacing: -0.01em;
    color: inherit;
  }

  .status-bolt {
    width: 0.95em;
    height: 0.95em;
    color: #16a34a;
  }

  .home-indicator {
    width: 36%;
    height: 1.3cqw;
    min-height: 4px;
    margin: 2.6cqw auto 2.4cqw;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.28);
    flex-shrink: 0;
  }

  .screen-content {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .screen-content :global(.mock-app) {
    height: 100%;
  }
</style>